BOT_TOKEN=1234567890:AAF...
GROQ_API_KEY=gsk_...
ADMIN_ID=123456789

# Адрес локального Telegram Bot API (для файлов до 2 ГБ)
# Если используете обычный Telegram API (до 20 МБ), оставьте пустым
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# Настройки аудио и лимитов
AUDIO_BITRATE=24k
CHUNK_MAX_MB=20.0
WHISPER_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
DEFAULT_LANGUAGE=auto
TASK_TIMEOUT_SEC=1800
